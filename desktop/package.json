{
  "name": "openvp-desktop",
  "productName": "OpenVP",
  "version": "0.1.0",
  "description": "OpenVP open-source virtual control processor, as a desktop app",
  "main": "main.js",
  "private": true,
  "license": "MIT",
  "author": "OpenVP contributors",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --x64 --publish never",
    "build:server": "dotnet publish ../src/OpenVP.Server -c Release -r win-x64 --self-contained true -o server",
    "build": "npm run build:server && npm run dist"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "org.openvp.desktop",
    "productName": "OpenVP",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "updater.js",
      "loading.html",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "server",
        "to": "server",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": "portable"
    },
    "portable": {
      "artifactName": "OpenVP.exe"
    }
  }
}
