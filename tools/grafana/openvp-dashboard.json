        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "openvp_slot_queue_depth{job=~\"$job\", instance=~\"$instance\", slot=~\"$slot\"}",
          "legendFormat": "",
          "refId": "E",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
