<Project Sdk="Microsoft.NET.Sdk">
  <!-- Reads and runs compiled SIMPL Windows programs (.lpz). Format notes: docs/lpz-format.md -->
  <ItemGroup>
    <ProjectReference Include="../OpenVP.Core/OpenVP.Core.csproj" />
    <!-- .smw parser, used to match compiled records to their source symbols when a program ships its source. -->
    <ProjectReference Include="../OpenVP.Simpl/OpenVP.Simpl.csproj" />
    <!-- Runtime pieces loaded per slot for SIMPL+ modules and the SIMPL# libraries they use. -->
    <ProjectReference Include="../OpenVP.SimplSharpHost/OpenVP.SimplSharpHost.csproj" />
    <ProjectReference Include="../OpenVP.Splus/OpenVP.Splus.csproj" />
    <ProjectReference Include="../SplusFacades/SplusObjects/SplusObjects.csproj" />
    <ProjectReference Include="../SplusFacades/SplusLibrary/SplusLibrary.csproj" />
    <ProjectReference Include="../SplusFacades/SmartThreadPoolCE/SmartThreadPoolCE.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Loaded in place of Crestron's JSON library when a program uses it. -->
    <ProjectReference Include="../Compat/SimplSharpNewtonsoft/SimplSharpNewtonsoft.csproj" />
  </ItemGroup>
</Project>
