<Project Sdk="Microsoft.NET.Sdk">
  <!--
    OpenVP for Windows: one OpenVP.exe that runs the server inside itself (no console window) and shows the
    web console in a native window (WebView2, the Edge engine built into Windows 10 and 11).
    Published as a single self-contained file, so it runs without installing .NET:
      dotnet publish src/OpenVP.Desktop -c Release -r win-x64 -o dist
    The "Windows app" GitHub workflow does this and uploads OpenVP.exe.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Not "OpenVP": the server's assembly is "openvp", and Windows file names ignore case.
         The published file is renamed to OpenVP.exe below. -->
    <AssemblyName>OpenVP.Desktop</AssemblyName>
    <RootNamespace>OpenVP.Desktop</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>openvp.ico</ApplicationIcon>
    <!-- The server project is an executable too; it's used here as a library. -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>
  <!-- Publishing: one self-contained OpenVP.exe. Everything (web pages, program shims) unpacks itself on first run. -->
  <PropertyGroup>
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <!-- The server's web pages and settings are listed below too, and may also arrive through the project reference. -->
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <ProjectReference Include="../OpenVP.Server/OpenVP.Server.csproj" />
  </ItemGroup>
  <!-- The server's web console and settings. A web project publishes these through its own pipeline, which
       doesn't reach projects that reference it, so they're included here explicitly. -->
  <ItemGroup>
    <Content Include="../OpenVP.Server/wwwroot/**" Link="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../OpenVP.Server/appsettings.json" Link="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="openvp.ico" />
  </ItemGroup>
  <Target Name="RenameToOpenVPExe" AfterTargets="Publish" Condition="'$(PublishSingleFile)' == 'true' And Exists('$(PublishDir)$(AssemblyName).exe')">
    <Move SourceFiles="$(PublishDir)$(AssemblyName).exe" DestinationFiles="$(PublishDir)OpenVP.exe" />
  </Target>
</Project>
