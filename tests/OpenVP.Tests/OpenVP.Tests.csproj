<Project Sdk="Microsoft.NET.Sdk">
  <!-- Dependency-free test runner (dotnet run). Builds offline; no test framework packages needed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/OpenVP.Core/OpenVP.Core.csproj" />
    <ProjectReference Include="../../src/OpenVP.SimplSharpHost/OpenVP.SimplSharpHost.csproj" />
    <ProjectReference Include="../../src/OpenVP.Simpl/OpenVP.Simpl.csproj" />
    <ProjectReference Include="../../src/OpenVP.Panels/OpenVP.Panels.csproj" />
    <ProjectReference Include="../../src/OpenVP.Lpz/OpenVP.Lpz.csproj" />
    <ProjectReference Include="../../src/OpenVP.Splus/OpenVP.Splus.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Build the sample program first so tests can load it. -->
    <ProjectReference Include="../../samples/SampleProgram/SampleProgram.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../samples/SplusModule/Sample_Splus.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
