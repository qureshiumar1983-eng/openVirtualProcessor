# OpenVP settings for the systemd service (/usr/lib/systemd/system/openvp.service). This file is kept when
# the package is upgraded. After editing it:  sudo systemctl restart openvp
#
# A setting is OpenVP__Name=value (two underscores where the docs write a colon): OpenVP:Slots is OpenVP__Slots.
# The full list of settings is in the OpenVP README. Some common ones:
#
# Where the console listens (the default is every address on port 8080). The name is Urls, as in appsettings.json:
#Urls=http://0.0.0.0:8080
# Only this computer:
#Urls=http://127.0.0.1:8080
#
# Number of program slots:
#OpenVP__Slots=10
#
# Touch panels over CIP (port 41794):
#OpenVP__CipEnabled=true
#
# The processor-style consoles (off by default; both need the access key as the password):
#OpenVP__TelnetEnabled=true
#OpenVP__SshEnabled=true
#
# Where programs, slot files, users and backups are kept. Leave it unless you have moved the data:
#OpenVP__DataDirectory=/var/lib/openvp
